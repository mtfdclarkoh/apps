rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mtfdclarkoh@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /artifacts/default-app-id/public/data/hospitals/{hospital} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /artifacts/default-app-id/public/data/hospital_logs/{log} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /artifacts/default-app-id/public/data/system_logs/{log} {
      allow read, write: if isAdmin();
    }
    match /artifacts/default-app-id/public/data/config_mappings/{mapping} {
      allow read, write: if isAdmin();
    }
  }
}
